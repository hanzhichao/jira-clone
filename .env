# .env.local

# disable next.js telemetry
NEXT_TELEMETRY_DISABLED=1

# app base url
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# database
DATABASE_URL=sqlite.db

# appwrite project and key (disabled)
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
# NEXT_PUBLIC_APPWRITE_PROJECT=69fb181a003892d96394
# NEXT_PUBLIC_APPWRITE_IMAGES_BUCKET_ID=69fb221a001eb27074c4
# NEXT_APPWRITE_KEY=...

# appwrite database ids (disabled)
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=69fb1c06000fd4b9a975
# NEXT_PUBLIC_APPWRITE_MEMBERS_ID=members
# NEXT_PUBLIC_APPWRITE_PROJECTS_ID=projects
# NEXT_PUBLIC_APPWRITE_TASKS_ID=tasks
# NEXT_PUBLIC_APPWRITE_WORKSPACES_ID=workspaces
